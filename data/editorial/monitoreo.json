{
  "version": 1,
  "policy": {
    "generative_ai": false,
    "emit_on_first_seen": false,
    "change_rule": "emit_when_latest_period_or_value_changes",
    "source_facts_only": true
  },
  "watches": [
    {
      "id": "bls-us-unemployment",
      "adapter": "bls_latest",
      "series": "LNS14000000",
      "indicator": "Unemployment rate",
      "geography": "United States",
      "unit": "%",
      "official_source": "U.S. Bureau of Labor Statistics",
      "access_url": "https://www.bls.gov/cps/",
      "area_clep": "trabajo-distribucion",
      "priority": 10
    },
    {
      "id": "wb-mx-gdp-growth",
