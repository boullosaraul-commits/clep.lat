{
  "paper_abierto": {
    "encabezado": "PAPER ABIERTO · CLEP",
    "campos_obligatorios": [
      "title",
      "authors",
      "summary",
      "access_url"
    ],
    "oa_obligatorio": true,
    "plantilla": "PAPER ABIERTO · CLEP\n\n{title}\n\n{authors_line}\n\nResumen de los autores (original):\n{summary}\n\n{translation_block}\nAcceso abierto:\n{access_url}\n\nDOI:\n{doi_display}",
    "nota": "Ficha automática mínima sin IA generativa: reproduce metadatos y abstract original; no genera pregunta, resumen ni traducción.",
    "traduccion": {
      "enabled": true,
      "target_language": "es",
      "engine": "argos-translate",
      "generative_ai": false,
      "label": "ES · Traducción automática",
      "preserve_original": true
    }
  },
  "version": 3,
  "textos_cortos": {
    "paper": {
      "label": "PAPER ABIERTO · CLEP",
      "template": "{title}\n\n{authors} · {source_or_series} · {year}\n\nAcceso abierto: {access_url}",
      "required": [
        "title",
        "authors",
        "source_or_series",
        "year",
        "access_url"
      ]
    },
    "book": {
      "label": "LIBRO ABIERTO · CLEP",
      "template": "{title}\n\n{authors_or_editors} · {year}\n\nAcceso abierto: {access_url}",
      "required": [
        "title",
        "authors_or_editors",
        "year",
        "access_url"
      ]
    },
    "dataset_grafica": {
      "label": "DATOS · CLEP",
      "template": "{indicator_or_dataset}\n\n{geography} · {reference_period}: {value_or_change}\n\nFuente: {official_source}\nDatos: {access_url}",
      "required": [
        "indicator_or_dataset",
        "geography",
        "reference_period",
        "value_or_change",
        "official_source",
        "access_url"
      ]
    },
    "convocatoria_evento": {
      "label": "AGENDA · CLEP",
      "template": "{title}\n\nOrganiza: {organizer}\n{date_label}: {date_or_deadline}\n\nInformación: {access_url}",
      "required": [
        "title",
        "organizer",
        "date_or_deadline",
        "access_url"
      ]
    },
    "video": {
      "label": "VIDEO · CLEP",
      "template": "{title}\n\n{speaker_or_organization}\n\nVer: {access_url}",
      "required": [
        "title",
        "speaker_or_organization",
        "access_url"
      ]
    },
    "recurso": {
      "label": "RECURSO · CLEP",
      "template": "{title}\n\nFuente: {source}\n\nAcceso: {access_url}",
      "required": [
        "title",
        "source",
        "access_url"
      ]
    },
    "chapter": {
      "label": "CAPÍTULO ABIERTO · CLEP",
      "template": "{title}\n\n{authors} · En: {container_title} · {year}\n\nAcceso abierto: {access_url}",
      "required": [
        "title",
        "authors",
        "container_title",
        "year",
        "access_url"
      ]
    },
    "report": {
      "label": "INFORME ABIERTO · CLEP",
      "template": "{title}\n\n{authors_or_institution} · {year}\n\nAcceso abierto: {access_url}",
      "required": [
        "title",
        "authors_or_institution",
        "year",
        "access_url"
      ]
    },
    "policy_brief": {
      "label": "POLICY BRIEF · CLEP",
      "template": "{title}\n\n{authors_or_institution} · {year}\n\nAcceso abierto: {access_url}",
      "required": [
        "title",
        "authors_or_institution",
        "year",
        "access_url"
      ]
    },
    "special_issue": {
      "label": "NÚMERO ESPECIAL · CLEP",
      "template": "{title}\n\n{journal} · {year}\n\nAcceso abierto: {access_url}",
      "required": [
        "title",
        "journal",
        "year",
        "access_url"
      ]
    },
    "thesis": {
      "label": "TESIS ABIERTA · CLEP",
      "template": "{title}\n\n{authors} · {institution} · {year}\n\nAcceso abierto: {access_url}",
      "required": [
        "title",
        "authors",
        "institution",
        "year",
        "access_url"
      ]
    },
    "edition_translation": {
      "label": "NUEVA EDICIÓN / TRADUCCIÓN · CLEP",
      "template": "{title}\n\n{authors_or_editors} · {edition_note} · {year}\n\nAcceso abierto: {access_url}",
      "required": [
        "title",
        "authors_or_editors",
        "edition_note",
        "year",
        "access_url"
      ]
    }
  },
  "reglas_texto": {
    "generative_ai": false,
    "prepend_label": true,
    "normalize_whitespace": true,
    "max_chars": 900,
    "max_paragraphs": 5,
    "on_missing_required": "block",
    "on_overflow": "truncate_optional_then_block",
    "prohibit": [
      "generated_summary",
      "generated_interpretation",
      "invented_transition",
      "invented_fact"
    ]
  }
}
