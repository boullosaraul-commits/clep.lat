{
  "version": 2,
  "principle": "prioridad editorial reproducible; no mide calidad científica",
  "eligibility": {
    "max_age_days": 21,
    "required": [
      "title",
      "publication_year",
      "access_url",
      "verified_access_or_oa",
      "identified_responsibility"
    ],
    "note": "La elegibilidad es binaria y no puede compensarse con puntos.",
    "detected_at_freshness_sources": [
      "nep_report",
      "doab_oai",
      "academic_oai"
    ],
    "freshness_rule": "Preferir fecha editorial exacta. Si no existe, detected_at sólo puede acreditar novedad para corrientes cuya consulta está temporalmente acotada por diseño."
  },
  "thresholds": {
    "publishable": 7,
    "outstanding": 9,
    "review": 5
  },
  "weights": {
    "pertinence_max": 4,
    "editorial_value_max": 3,
    "recency_max": 1,
    "access_max": 1,
    "regional_pluralist_max": 1
  },
  "editorial_value": {
    "substantive_types": [
      "paper",
      "book",
      "chapter",
      "report",
      "policy_brief",
      "special_issue",
      "thesis",
      "edition_translation"
    ],
